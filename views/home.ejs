<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>URL Shortener</title>
  <style>
    
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>URL Shortener</h1>
      <p>Enter a long URL to generate a shortened link and track clicks.</p>
    </header>

    <% if (locals.id) { %>
      <div class="alert-success">
        <div>
          🎉 <strong>Short URL Generated:</strong>
          <a id="shortUrlLink" href="/url/<%= id %>" target="_blank">
            http://localhost:8001/url/<%= id %>
          </a>
        </div>
        <button type="button" class="btn-copy" onclick="copyToClipboard()">Copy</button>
      </div>
    <% } %>

    <div class="card">
      <form method="POST" action="/url" class="form-group">
        <label for="urlInput">Original URL</label>
        <div class="input-wrapper">
          <input 
            type="url" 
            id="urlInput" 
            name="url" 
            placeholder="https://example.com/very-long-url-here" 
            required 
          />
          <button type="submit">Shorten</button>
        </div>
      </form>
    </div>

    <div class="card" style="padding: 0; overflow-x: auto;">
      <% if (locals.urls && urls.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Short ID</th>
              <th>Original Link</th>
              <th>Total Clicks</th>
            </tr>
          </thead>
          <tbody>
            <% urls.forEach((urlItem, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td>
                  <a href="/url/<%= urlItem.shortId %>" target="_blank" style="color: var(--primary); text-decoration: none; font-weight: 600;">
                    <%= urlItem.shortId %>
                  </a>
                </td>
                <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  <a href="<%= urlItem.redirectUrl %>" target="_blank" style="color: inherit; text-decoration: none;">
                    <%= urlItem.redirectUrl %>
                  </a>
                </td>
                <td>
                  <span class="badge"><%= urlItem.visitHistory.length %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <p>No URLs created yet. Shorten your first link above!</p>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    function copyToClipboard() {
      const link = document.getElementById('shortUrlLink').href;
      navigator.clipboard.writeText(link).then(() => {
        const btn = document.querySelector('.btn-copy');
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = 'Copy'), 2000);
      });
    }
  </script>
</body>
</html>